# Generated by ./install.sh. Do not commit the real .env file.
COMPOSE_PROFILES=9router,smart-router,hermes,open-webui

# Image policy: mutable latest/main is the default by operator choice.
# To pin later, change only the *_IMAGE_TAG values below, then run:
#   docker compose --env-file .env pull && docker compose --env-file .env up -d

# Content Manager layer: this checkout is the daily content-production stack.
# Canonical editorial policy and category definitions live in content/config/
# (tracked). install.sh seeds a gitignored working copy under
# data/content-manager/config and writes N8N_TIMEZONE for the orchestration
# schedule. Pipeline source, policy, and operations notes: content/README.md.

# Base domain for the published services. install.sh asks for it once and
# derives every hostname suggestion from it, and ./manage.sh s3-guide prints
# the reverse-proxy checklist with the same names. Services are published as
# <service>.<STACK_BASE_DOMAIN>, for example s3.stack.example.com when the
# value is stack.example.com. Empty keeps example.com placeholders in the
# printed checklists; the recorded public URLs in this file still win over it.
STACK_BASE_DOMAIN=

NINEROUTER_IMAGE_REPOSITORY=decolua/9router
NINEROUTER_IMAGE_TAG=latest
NINEROUTER_BIND_IP=127.0.0.1
NINEROUTER_PORT=20128
NINEROUTER_INITIAL_PASSWORD=CHANGE_ME
NINEROUTER_JWT_SECRET=CHANGE_ME
NINEROUTER_API_KEY_SECRET=CHANGE_ME
NINEROUTER_MACHINE_ID_SALT=CHANGE_ME
NINEROUTER_REQUIRE_API_KEY=false
NINEROUTER_AUTH_COOKIE_SECURE=false
NINEROUTER_PUBLIC_BASE_URL=http://localhost:20128

# Alternative router backend: OmniRoute (profile "omniroute"). install.sh asks
# which backend to install (9router or OmniRoute); keep only the selected
# backend block in use. OmniRoute exposes the dashboard on 20128 and its
# OpenAI-compatible API on 20129. The management key below is the stack-only
# bootstrap credential mapped to the container OMNIROUTE_API_KEY; it is used
# for local management provisioning and must never be handed to clients.
OMNIROUTE_IMAGE_REPOSITORY=diegosouzapw/omniroute
OMNIROUTE_IMAGE_TAG=latest
OMNIROUTE_BIND_IP=127.0.0.1
OMNIROUTE_PORT=20128
OMNIROUTE_API_BIND_IP=127.0.0.1
OMNIROUTE_API_PORT=20129
OMNIROUTE_INITIAL_PASSWORD=CHANGE_ME
OMNIROUTE_JWT_SECRET=CHANGE_ME
OMNIROUTE_API_KEY_SECRET=CHANGE_ME
OMNIROUTE_MANAGEMENT_API_KEY=CHANGE_ME
OMNIROUTE_STORAGE_ENCRYPTION_KEY=CHANGE_ME
OMNIROUTE_STORAGE_ENCRYPTION_KEY_VERSION=v1
OMNIROUTE_MACHINE_ID_SALT=CHANGE_ME
OMNIROUTE_WS_BRIDGE_SECRET=CHANGE_ME
OMNIROUTE_REQUIRE_API_KEY=false
OMNIROUTE_AUTH_COOKIE_SECURE=false
OMNIROUTE_PUBLIC_BASE_URL=http://localhost:20128
OMNIROUTE_ALLOW_API_KEY_REVEAL=false
OMNIROUTE_MEMORY_MB=512

HERMES_IMAGE_REPOSITORY=nousresearch/hermes-agent
HERMES_IMAGE_TAG=latest
HERMES_BIND_IP=127.0.0.1
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
# When the dashboard is enabled, install.sh provisions a random Basic Auth
# username/password. Only the scrypt hash is stored here; the plaintext password
# is kept in data/stack-secrets/hermes-dashboard-access.env (mode 0600).
HERMES_DASHBOARD=0
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
HERMES_UID=10000
HERMES_GID=10000
# Package installs remain unprivileged and persist under data/hermes/.
# Their container targets and trusted PATH ordering are enforced by Compose.

# Execution stays off until manage.sh enables one or more features.
EXECUTION_FEATURES=
EXECUTION_POLICY_GENERATION=0
EXECUTION_WORKSPACE_GENERATION=0
EXECUTION_BROKER_IMAGE=afsharidevops/hermes-execution-broker:0.1.3
EXECUTION_SANDBOX_IMAGE=python:3.13.5-slim-bookworm@sha256:4c2cf9917bd1cbacc5e9b07320025bdb7cdf2df7b0ceaccb55e9dd7e30987419
EXECUTION_RUN_AS=10003:10003
# Fail-closed sentinel. install.sh replaces this with the host Docker socket GID when present.
EXECUTION_DOCKER_GID=65534
EXECUTION_WORKSPACE_HOST_PATH=/absolute/path/to/content-manager/data/execution-workspace
# v0.5.9 browser-facing Execution Admin boundary. Bind loopback by default.
EXECUTION_ADMIN_ENABLED=false
EXECUTION_ADMIN_BIND_IP=127.0.0.1
EXECUTION_ADMIN_PORT=8752
# Add your private Operations Center origin when accessing from another machine,
# e.g. http://192.168.85.243:8787. Do not use wildcard origins.
EXECUTION_ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

SMART_ROUTER_IMAGE_REPOSITORY=afsharidevops/hermes-smart-router
SMART_ROUTER_IMAGE_TAG=0.5.9
SMART_ROUTER_BIND_IP=127.0.0.1
SMART_ROUTER_PORT=8787
SMART_ROUTER_MODE=observe
SMART_ROUTER_POLICY=heuristic
# Switch to calibrated only after evaluating your workload.
SMART_ROUTER_HMAC_SECRET=CHANGE_ME
# Optional file/Docker-secret source; leave direct value blank when using *_FILE.
SMART_ROUTER_HMAC_SECRET_FILE=
SMART_ROUTER_POLICY_VERSION=4

SMART_ROUTER_OBSERVE_MODEL=ai

SMART_ROUTER_FAST_MODEL=combo-fast
SMART_ROUTER_STANDARD_MODEL=combo-standard
SMART_ROUTER_STRONG_MODEL=combo-strong

SMART_ROUTER_FAST_SUPPORTS_TOOLS=false
SMART_ROUTER_FAST_SUPPORTS_VISION=false
SMART_ROUTER_FAST_MAX_CONTEXT=32000

SMART_ROUTER_STANDARD_SUPPORTS_TOOLS=true
SMART_ROUTER_STANDARD_SUPPORTS_VISION=false
SMART_ROUTER_STANDARD_MAX_CONTEXT=128000

SMART_ROUTER_STRONG_SUPPORTS_TOOLS=true
SMART_ROUTER_STRONG_SUPPORTS_VISION=true
SMART_ROUTER_STRONG_MAX_CONTEXT=200000

SMART_ROUTER_SESSION_TTL_SECONDS=2700
SMART_ROUTER_MAX_SESSION_AGE_SECONDS=43200
SMART_ROUTER_DEMOTION_TURNS=5

SMART_ROUTER_FAST_MAX_TOKENS=1024
SMART_ROUTER_STANDARD_MAX_TOKENS=4096
SMART_ROUTER_STRONG_MAX_TOKENS=6144

SMART_ROUTER_CONNECT_TIMEOUT_SECONDS=10
SMART_ROUTER_READ_TIMEOUT_SECONDS=600
SMART_ROUTER_MAX_REQUEST_BYTES=10485760


OPENWEBUI_IMAGE_REPOSITORY=ghcr.io/open-webui/open-webui
OPENWEBUI_IMAGE_TAG=main
OPENWEBUI_BIND_IP=127.0.0.1
OPENWEBUI_PORT=3000
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_SECRET_KEY=CHANGE_ME
OPENWEBUI_OPENAI_BASE_URL=http://smart-router:8080/v1
# install.sh synchronizes this to SMART_ROUTER_CLIENT_API_KEY.
OPENWEBUI_OPENAI_API_KEY=CHANGE_ME_V052_CLIENT_KEY
OPENWEBUI_ENABLE_SIGNUP=false
# Uploaded files and generated images: local (data/open-webui) or s3
# (the shared S3 block further down). The installer flips this to s3
# when object storage is enabled for Open WebUI.
OPENWEBUI_STORAGE_PROVIDER=local

N8N_IMAGE_REPOSITORY=n8nio/n8n
N8N_IMAGE_TAG=latest
# off, instance, or trigger. Instance access/token is enabled in the n8n owner UI.
N8N_MCP_MODE=off
# Shared tool registry the n8n bootstrap reads to report the tools the
# connector may call (the same file SMART_ROUTER_TOOLS_REGISTRY points at).
# ./manage.sh bootstrap-n8n mounts the config directory at /tools and sets
# this to /tools/tools.json; set it yourself only when running the script
# directly.
N8N_TOOLS_REGISTRY=/tools/tools.json
N8N_BIND_IP=127.0.0.1
N8N_PORT=5678
N8N_HOSTNAME=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=0
N8N_TIMEZONE=Asia/Tehran
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
# Rotating this makes every stored n8n credential undecryptable. Back it up.
N8N_ENCRYPTION_KEY=CHANGE_ME

CADDY_IMAGE=caddy:2-alpine
CADDY_BIND_IP=0.0.0.0

# Content Bot (Telegram approve/publish bot; optional "content" compose profile).
# install.sh asks for the bot token, operator IDs, and the publish channel and
# fills CONTENT_WRITER_* from the selected stack writer. Runtime state stays
# under data/content-bot; the editorial working copy is data/content-manager/config.
# The image is built on GitHub Actions and published to Docker Hub; install.sh
# pulls it, so no local build is needed.
CONTENT_BOT_IMAGE_REPOSITORY=afsharidevops/content-bot
CONTENT_BOT_IMAGE_TAG=0.3.0
CONTENT_BOT_RUN_AS=10004:10004
CONTENT_BOT_TOKEN=
CONTENT_TELEGRAM_CHANNEL=
CONTENT_TELEGRAM_USERS=
CONTENT_TELEGRAM_API_BASE=https://api.telegram.org
CONTENT_WRITER_BASE_URL=
CONTENT_WRITER_API_KEY=
CONTENT_WRITER_MODEL=auto
CONTENT_WRITER_MAX_TOKENS=1600
CONTENT_WRITER_REASONING_EFFORT=
CONTENT_SCHEDULER_ENABLED=true
# Media Studio job endpoint. In the full compose stack the internal name
# http://media-studio:8850 works; standalone installs point this at their host
# or remote Media Studio URL (e.g. http://127.0.0.1:8850).
# The installer fills the URL, token, and drivers automatically when Content
# Bot and Media Studio are installed together on the same server.
CONTENT_MEDIA_STUDIO_URL=
CONTENT_MEDIA_STUDIO_TOKEN=
CONTENT_MEDIA_IMAGE_DRIVER=api-image
CONTENT_MEDIA_VIDEO_DRIVER=flow-video
# Media Studio driver used when the operator asks for an uploaded video to be
# edited before publishing; "video-edit" normalises the clip with ffmpeg.
CONTENT_MEDIA_VIDEO_EDIT_DRIVER=video-edit
CONTENT_MEDIA_JOB_TIMEOUT_SECONDS=1200
# Topic input mode: messages without a link are searched (DuckDuckGo HTML,
# no API key) and drafted. CONTENT_SEARCH_ENABLED also powers the fallback
# used when a sent link contains almost no readable text.
CONTENT_SEARCH_ENABLED=true
CONTENT_TOPIC_DRAFTS_ENABLED=true
CONTENT_SEARCH_MAX_RESULTS=5
CONTENT_SEARCH_TIMEOUT=25
# Video prompt workflow. When CONTENT_VIDEO_CHARACTER names a saved
# Google Flow character (for example @mohammad) the "My video (get a
# prompt)" flow first asks whether the reel should use that character
# or run as a pure-AI promo. CONTENT_VIDEO_CHARACTER_PROMPT replaces
# the built-in character description and keeps the {handle} and
# {aspect} placeholders. CONTENT_VIDEO_SEGMENT_SECONDS is the clip
# length Flow generates per Extend segment.
CONTENT_VIDEO_CHARACTER=
CONTENT_VIDEO_CHARACTER_PROMPT=
CONTENT_VIDEO_ASPECT="9:16 vertical"
CONTENT_VIDEO_SEGMENT_SECONDS=10
# Manual-upload platform packages (the "More platforms..." button) are off by
# default: Telegram and Instagram publish through their APIs. Set to true to
# offer copy-ready YouTube/Aparat packages from every preview. The platform
# list itself lives in the platforms: section of editorial-policy.yaml.
CONTENT_PLATFORMS_ENABLED=false

# Optional Instagram publishing through the official Meta Graph API. Media is
# published from publicly reachable URLs, so INSTAGRAM_MEDIA_PUBLIC_BASE_URL
# must point to a public path that serves the files under data/content-bot.
# See docs/INSTAGRAM-SETUP.md for the account, app, and token checklist.
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=
# Public HTTPS address that serves data/content-bot/media (required: the Graph
# API downloads the file itself). Keep it empty to let the optional
# "ig-media" profile run nginx + a cloudflared quick tunnel and report the
# address it gets; set a stable hostname (for example
# https://media.example.com/base) once the stack owns a domain.
INSTAGRAM_MEDIA_PUBLIC_BASE_URL=
# Optional nginx + cloudflared media host.
# Profile "ig-media" serves data/content-bot/media; ./manage.sh
# instagram-media-enable adds the tunnel on top. Set a LAN address here when a
# reverse proxy on another host (for example the router) fronts the media host.
IG_MEDIA_BIND_IP=127.0.0.1
IG_MEDIA_PORT=8099
# Set a token from a named Cloudflare tunnel to keep one permanent hostname:
# ./manage.sh instagram-media-enable then uses profile "ig-media-named"
# instead of the quick tunnel, and the public hostname is the one configured
# in the Cloudflare dashboard (route it to http://ig-media:80), for example
# https://media.example.com. Pin that same value in
# INSTAGRAM_MEDIA_PUBLIC_BASE_URL or data/content-bot/media-base-url.txt.
IG_MEDIA_TUNNEL_TOKEN=
# API host: https://graph.facebook.com (Facebook Login tokens) or
# https://graph.instagram.com (Instagram API with Instagram Login tokens).
INSTAGRAM_API_BASE=https://graph.facebook.com
INSTAGRAM_API_VERSION=v26.0
# Only for tokens minted through Facebook Login; the bot uses them to extend
# the long-lived token. Instagram Login tokens refresh without a secret.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_POLL_TIMEOUT_SECONDS=600
# Automatic publishing to Instagram through the Graph API. Set it to false to
# keep the Instagram API buttons out of the bot and the operator panel and use
# the Post package console action instead: the bot sends the untouched media
# file and a copy-ready caption to the operator chat for a manual upload.
INSTAGRAM_AUTO_PUBLISH=true
# Set it to true to stop the scheduled long-lived token refresh entirely (for
# example while Meta reviews the account); the bot then never calls the token
# endpoints on its own.
INSTAGRAM_DISABLE_REFRESH=false

# Media Studio (optional "media" compose profile). Browser drivers generate
# video/images through a signed-in Google Flow/Gemini session (CDP mode
# attaches to the operator's desktop Chrome; see docs/MEDIA-STUDIO.md). The
# api-image driver needs only an OpenAI-compatible gateway and reuses the
# Content Bot writer values when MEDIA_STUDIO_WRITER_* are empty. State and
# generated artifacts live under data/media-studio.
MEDIA_STUDIO_IMAGE_REPOSITORY=afsharidevops/media-studio
MEDIA_STUDIO_IMAGE_TAG=0.3.0
MEDIA_STUDIO_RUN_AS=10005:10005
MEDIA_STUDIO_BIND_IP=127.0.0.1
MEDIA_STUDIO_PORT=8850
MEDIA_STUDIO_API_TOKEN=
MEDIA_STUDIO_DRIVERS=api-image,flow-video,video-edit
MEDIA_STUDIO_WRITER_BASE_URL=
MEDIA_STUDIO_WRITER_API_KEY=
MEDIA_STUDIO_WRITER_MODEL=auto
MEDIA_STUDIO_IMAGE_SIZE=1024x1024
# Brand chip on AI images and uploaded photos (blank disables; corner of the image)
MEDIA_STUDIO_BRAND_LABEL=Locallab
MEDIA_STUDIO_BRAND_POSITION=bottom-right
# aurora = gradient pill with halo, hexagon mark and highlight; chip = plain dark chip
MEDIA_STUDIO_BRAND_STYLE=aurora
MEDIA_STUDIO_SESSION_MODE=cdp
MEDIA_STUDIO_CDP_URL=http://host.docker.internal:9222
MEDIA_STUDIO_HEADLESS=true
MEDIA_STUDIO_BLOCK_GEO_REDIRECT=true
MEDIA_STUDIO_FREEZE_ON_READY=true
MEDIA_STUDIO_FLOW_AUTO_APPROVE=false
MEDIA_STUDIO_FLOW_QUALITY=720p
MEDIA_STUDIO_STEP_TIMEOUT_SECONDS=30
MEDIA_STUDIO_JOB_TIMEOUT_SECONDS=900
MEDIA_STUDIO_TIMEZONE=Asia/Tehran
# video-edit driver: normalise an operator-uploaded clip with ffmpeg.
# MAX_SIDE caps the long side in pixels, MAX_SECONDS trims the clip (0 keeps
# the full length), TIMEOUT_SECONDS bounds one ffmpeg run, and
# UPLOAD_TTL_SECONDS prunes stored uploads. MEDIA_STUDIO_FFMPEG pins a binary;
# when empty the image uses the one bundled with the imageio-ffmpeg wheel.
MEDIA_STUDIO_VIDEO_EDIT_MAX_SIDE=1920
MEDIA_STUDIO_VIDEO_EDIT_MAX_SECONDS=0
MEDIA_STUDIO_VIDEO_EDIT_TIMEOUT_SECONDS=900
MEDIA_STUDIO_UPLOAD_TTL_SECONDS=86400
MEDIA_STUDIO_FFMPEG=

# Shared S3-compatible object storage (optional "rustfs" compose profile for
# the bundled server). One endpoint backs every service that understands
# object storage, so the stack can keep its files on RustFS, MinIO, AWS S3,
# Cloudflare R2, Backblaze B2, Arvan S3, or any other S3-compatible provider:
#   S3_STORAGE_BACKEND=rustfs   -> bundled RustFS container from this stack
#   S3_STORAGE_BACKEND=external -> endpoint and keys below point elsewhere
#   S3_STORAGE_BACKEND=off      -> services keep their local/bind storage
# Configure it with "./manage.sh s3-enable --rustfs" or
# "--external", prove it with "./manage.sh s3-verify", and read
# docs/S3-STORAGE.md for the per-service status and the public-domain setup.
S3_STORAGE_BACKEND=off
# Endpoint the containers use. For the bundled server that is the Compose
# service name; for an external provider use its S3 URL (for example
# https://s3.eu-central-1.amazonaws.com or https://<account>.r2.cloudflarestorage.com).
S3_ENDPOINT_URL=
# Optional endpoint for tools that run on the Docker host instead of inside
# the stack network (./manage.sh s3-verify). Empty derives it from the RustFS
# bind address when the backend is "rustfs".
S3_HOST_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=locallab
S3_REGION=us-east-1
# Path-style addressing is required by RustFS, MinIO, and most self-hosted
# endpoints. Turn it off only for providers that expect virtual-hosted style.
S3_FORCE_PATH_STYLE=true
# Optional key prefix inside the bucket, for example "locallab/".
S3_KEY_PREFIX=
# Consumer switches. Open WebUI stores uploaded files and generated images in
# the bucket when OPENWEBUI_STORAGE_PROVIDER is "s3" (set it in the Open WebUI
# block above); "local" keeps them under data/open-webui. The Content Bot and
# Media Studio keep their artifacts on disk today (see docs/S3-STORAGE.md for
# the supported matrix).

# Bundled RustFS server (Apache-2.0). The S3 API listens on 9000 and the web
# console on 9001 under /rustfs/console/. RUSTFS_ACCESS_KEY/SECRET_KEY are
# the same credentials the services receive as S3_ACCESS_KEY_ID/SECRET.
RUSTFS_IMAGE_REPOSITORY=rustfs/rustfs
RUSTFS_IMAGE_TAG=latest
# Bind 127.0.0.1 for stack-only use, or the LAN address when a reverse proxy
# on another host (for example the router) publishes the API or the console.
RUSTFS_BIND_IP=127.0.0.1
RUSTFS_PORT=9000
RUSTFS_CONSOLE_BIND_IP=127.0.0.1
RUSTFS_CONSOLE_PORT=9001
RUSTFS_UID=10001
RUSTFS_GID=10001
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_REGION=us-east-1
RUSTFS_CONSOLE_PREFIX=/rustfs/console
# Public HTTPS origin that fronts the S3 API (for example
# https://s3.stack.example.com). Empty means the API is LAN/loopback only.
S3_PUBLIC_BASE_URL=
# Public HTTPS origin that fronts the console, used when the console runs
# behind a reverse proxy so its browser redirects stay on the public host.
S3_PUBLIC_CONSOLE_URL=
# Operator panel (optional "panel" compose profile): a small web console for
# stack status, validated configuration editing, service logs and a fixed
# whitelist of actions. Keep it on loopback by default; when it must be
# reachable remotely, publish it through a reverse proxy with HTTPS and set
# PANEL_COOKIE_SECURE=true. install.sh asks whether a reverse proxy on another
# host publishes the console and suggests the detected LAN address for
# PANEL_BIND_IP. PANEL_RUN_AS must be the stack owner (so edited files keep
# that owner) and PANEL_DOCKER_GID must be the host group that owns
# /var/run/docker.sock. The operator token lives in data/panel/token and is
# printed by ./manage.sh panel-token. PANEL_STACK_PATH is normally exported by
# manage.sh; empty means the current directory.
PANEL_IMAGE_REPOSITORY=afsharidevops/content-panel
PANEL_IMAGE_TAG=0.3.0
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=8899
PANEL_ACTIONS_ENABLED=true
PANEL_COOKIE_SECURE=false
PANEL_RUN_AS=1000:1000
PANEL_DOCKER_GID=984
PANEL_STACK_PATH=

SMART_ROUTER_CALIBRATION_FILE=/policy/calibrated.json
SMART_ROUTER_UPSTREAM_BASE_URL=http://nine-router:20128/v1
SMART_ROUTER_UPSTREAM_HEALTH_URL=http://nine-router:20128/api/health
SMART_ROUTER_UPSTREAM_API_KEY=
SMART_ROUTER_UPSTREAM_API_KEY_FILE=
SMART_ROUTER_CLIENT_API_KEY=CHANGE_ME_V052_CLIENT_KEY
SMART_ROUTER_CLIENT_API_KEY_FILE=
SMART_ROUTER_DATABASE_PATH=/data/router.sqlite3
SMART_ROUTER_OBSERVATION_FILE=/data/observations-v4.jsonl
# Shared tool registry (content/config/tools.json seed, seeded into
# data/content-manager/config). GET /v1/tools serves the entries whose
# consumers list includes "router"; blank disables the endpoint's data.
SMART_ROUTER_TOOLS_REGISTRY=/policy-content/tools.json
SMART_ROUTER_PREFERRED_TOKEN_FIELD=max_tokens
SMART_ROUTER_LEARNED_MODEL_FILE=/policy/learned-v4.joblib
SMART_ROUTER_LEARNED_METADATA_FILE=/policy/learned-v4.json
SMART_ROUTER_LEARNED_MIN_CONFIDENCE=0.70
SMART_ROUTER_LEARNED_FALLBACK=standard
SMART_ROUTER_LEARNED_ERROR_FALLBACK=heuristic

# Smart Router v0.4.0 notes
# SMART_ROUTER_HMAC_SECRET is required and must be >=32 strong characters.
# Generate once: openssl rand -hex 32
# Keep it stable across restarts and never commit the real .env.

# Smart Router v0.4.0 hardening
# Conservative margin applied to approximate prompt-token counts for hard context gates.
SMART_ROUTER_CONTEXT_TOKEN_SAFETY_FACTOR=1.15
# Keep false for normal external clients. Set true only for trusted callers that may force tiers.
SMART_ROUTER_ALLOW_TIER_OVERRIDES=false

# Smart Router v0.5.0 measured cost dashboard
SMART_ROUTER_COST_LEDGER_ENABLED=true
SMART_ROUTER_COST_DATABASE_PATH=/data/cost-ledger.sqlite3
# Copy smart-router/policy/pricing-v0.5.example.json to pricing-v0.5.json and fill real prices before claiming USD savings.
SMART_ROUTER_PRICING_FILE=/policy/pricing-v0.5.json
SMART_ROUTER_DASHBOARD_ENABLED=true

# Smart Router v0.5.9 UX/runtime on the v0.5.2 persisted control schema
# The installer auto-generates SMART_ROUTER_BOOTSTRAP_ADMIN_USER (random for
# new installs, preserved on upgrades) and all other force-set secrets.
SMART_ROUTER_CONTROL_PLANE_ENABLED=true
SMART_ROUTER_CONTROL_DATABASE_URL=sqlite:////data/control-v0.5.2.sqlite3
SMART_ROUTER_ADMIN_API_KEY=CHANGE_ME_V052_ADMIN_KEY
SMART_ROUTER_ADMIN_API_KEY_FILE=
SMART_ROUTER_BOOTSTRAP_ADMIN_USER=admin
SMART_ROUTER_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_V052_BOOTSTRAP_PASSWORD
SMART_ROUTER_BOOTSTRAP_ADMIN_PASSWORD_FILE=
SMART_ROUTER_REQUIRE_AUTH=true
SMART_ROUTER_HA_MODE=false
SMART_ROUTER_CODING_MODEL=combo-strong
SMART_ROUTER_VISION_MODEL=combo-strong
SMART_ROUTER_ANON_RPM=30
SMART_ROUTER_ANON_TPM=200000
SMART_ROUTER_ANON_DAILY_REQUESTS=1000
# Trusted stack client used by Hermes/Open WebUI/n8n. Long tool sessions can resend 50k-100k+ token contexts.
SMART_ROUTER_CLIENT_RPM=120
SMART_ROUTER_CLIENT_TPM=2000000
SMART_ROUTER_CLIENT_DAILY_REQUESTS=10000
# Defaults for virtual API keys created in Hermes Operations Center. Existing virtual-key limits are editable in-place.
SMART_ROUTER_VIRTUAL_KEY_DEFAULT_RPM=60
SMART_ROUTER_VIRTUAL_KEY_DEFAULT_TPM=1000000
SMART_ROUTER_VIRTUAL_KEY_DEFAULT_DAILY_REQUESTS=5000
# Empty = RAG knowledge tables share SMART_ROUTER_CONTROL_DATABASE_URL; set a SQLAlchemy PostgreSQL DSN for a separate RAG DB.
SMART_ROUTER_KNOWLEDGE_DATABASE_URL=
# v0.5.9 hybrid/vector RAG. PostgreSQL uses pgvector when the extension is available; SQLite uses the portable vector fallback.
SMART_ROUTER_RAG_MODE=hybrid
SMART_ROUTER_EMBEDDINGS_BASE_URL=
SMART_ROUTER_EMBEDDINGS_MODEL=text-embedding-3-small
SMART_ROUTER_EMBEDDINGS_API_KEY=
SMART_ROUTER_EMBEDDINGS_DIMENSIONS=384
SMART_ROUTER_EMBEDDINGS_TIMEOUT_SECONDS=20
# v0.5.9 request guardrails. audit records findings; enforce blocks configured high-risk findings.
SMART_ROUTER_GUARDRAILS_MODE=audit
SMART_ROUTER_ALLOWED_TOOLS=
SMART_ROUTER_GUARDRAIL_DENY_PATTERNS=
SMART_ROUTER_SESSION_TTL_SECONDS_V51=28800
# For PostgreSQL HA use smart-router/compose-ha-v0.5.9.example.yml
SMART_ROUTER_PG_DB=hermes_router
SMART_ROUTER_PG_USER=hermes_router
SMART_ROUTER_PG_PASSWORD=CHANGE_ME_V052_PG_PASSWORD
SMART_ROUTER_PG_PASSWORD_FILE=

# Smart Router v0.5.9 reliability / HA foundation
SMART_ROUTER_REDIS_URL=
SMART_ROUTER_REDIS_PASSWORD=CHANGE_ME_V052_REDIS_PASSWORD
SMART_ROUTER_STICKY_BACKEND=auto
SMART_ROUTER_REDIS_REQUIRED=false
SMART_ROUTER_CIRCUIT_FAILURE_THRESHOLD=5
SMART_ROUTER_CIRCUIT_FAILURE_WINDOW_SECONDS=60
SMART_ROUTER_CIRCUIT_COOLDOWN_SECONDS=30
SMART_ROUTER_PROVIDER_HEALTH_ENABLED=true
SMART_ROUTER_OIDC_ENABLED=false
SMART_ROUTER_OIDC_ISSUER_URL=
SMART_ROUTER_OIDC_CLIENT_ID=
SMART_ROUTER_OIDC_CLIENT_SECRET=
SMART_ROUTER_OIDC_CLIENT_SECRET_FILE=
SMART_ROUTER_OIDC_REDIRECT_URI=
SMART_ROUTER_OIDC_GROUP_ROLE_MAP=
SMART_ROUTER_OIDC_DEFAULT_ROLE=user
SMART_ROUTER_OIDC_AUTO_PROVISION=true
SMART_ROUTER_OIDC_LOCAL_LOGIN_ENABLED=true
SMART_ROUTER_KNOWLEDGE_ACL_DEFAULT_DENY=false
