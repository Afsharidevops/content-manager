{
  "manifest_version": 3,
  "name": "Locallab Flow Unlock",
  "version": "0.1.2",
  "description": "Locallab: keeps flow.google.com usable when Google redirects unsupported regions to the unsupported-country page.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "geo_redirect_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*"
      ],
      "js": [
        "freeze.js"
      ],
      "run_at": "document_start"
    }
  ]
}
