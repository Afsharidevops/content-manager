{
  "manifest_version": 3,
  "name": "Locallab Flow Unlock",
  "version": "0.4.0",
  "description": "Locallab: keeps flow.google.com usable when Google marks the signed-in account as an unsupported country, including multi-account /u/<n>/ URLs.",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "geo_redirect_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*"
      ],
      "js": [
        "freeze.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*"
      ],
      "js": [
        "unlock.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
