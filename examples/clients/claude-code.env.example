# Claude Code configured for Smart Router.
#
# Source this file before starting `claude`, or copy the same names into the
# "env" block of ~/.claude/settings.json:
#
#   {
#     "env": {
#       "ANTHROPIC_BASE_URL": "https://api.example.com",
#       "ANTHROPIC_AUTH_TOKEN": "<client key>",
#       "ANTHROPIC_MODEL": "auto"
#     }
#   }

# Origin only: Claude Code appends /v1/messages itself. Do not add /v1 here.
export ANTHROPIC_BASE_URL="https://api.example.com"

# Smart Router client key. ANTHROPIC_AUTH_TOKEN sends Authorization: Bearer.
# Use ANTHROPIC_API_KEY instead when the client can only send x-api-key;
# Smart Router accepts both headers.
export ANTHROPIC_AUTH_TOKEN="<SMART_ROUTER_CLIENT_API_KEY>"

# Every model Claude Code can request must map onto a router alias, otherwise a
# claude-* name is forwarded upstream verbatim as an explicit model.
export ANTHROPIC_MODEL="auto"
export ANTHROPIC_SMALL_FAST_MODEL="auto"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="auto"
export ANTHROPIC_DEFAULT_SONNET_MODEL="auto"
export ANTHROPIC_DEFAULT_OPUS_MODEL="auto"

# Optional: the real context window of the tier behind the alias. Without it
# Claude Code assumes 200k tokens for the unknown "auto" model.
# export CLAUDE_CODE_MAX_CONTEXT_TOKENS="200000"
